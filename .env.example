# Copy to .env (gitignored) and fill in. The server loads .env itself.

# ─── Notifications (Knock) ───
# Leave these empty and Notifications are written to .notifications/ instead.
# All four come from the Knock dashboard, Development environment.
KNOCK_SECRET_API_KEY=
KNOCK_PUBLIC_API_KEY=
# Enhanced security signing key. Paste the base64 value as shown; PEM works too.
KNOCK_SIGNING_KEY=
# The id (not the key) of the in-app feed channel.
KNOCK_FEED_CHANNEL_ID=
# Put in front of every Knock user id, so checkouts sharing one Knock
# environment don't see each other's Notifications. E.g. "sam-laptop-".
KNOCK_RECIPIENT_PREFIX=

# Only for `npm run knock:push` (the Knock CLI). Export it in your shell;
# the CLI doesn't read .env. Dashboard > Settings > Service tokens.
# KNOCK_SERVICE_TOKEN=
